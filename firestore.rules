rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if (request.auth.uid == userId
                     && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
                     && (!('medals' in resource.data) || request.resource.data.medals == resource.data.medals))
                     || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer'];
    }
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer'];
    }
  }
}