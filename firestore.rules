rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer', 'cap'] ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.club == resource.data.club)
      );
      allow write: if (request.auth.uid == userId
                     && (!('role' in resource.data) || !('role' in request.resource.data) || request.resource.data.role == resource.data.role)
                     && (!('awards' in resource.data) || !('awards' in request.resource.data) || request.resource.data.awards == resource.data.awards))
                     || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer'];
    }
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer'];
    }
    match /awards/{awardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}