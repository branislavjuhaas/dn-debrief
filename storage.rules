rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /events/thumbnails/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
      request.auth.token.role in ['admin', 'developer', 'organizer', 'junior']
      );
    }
    match /events/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /events/files/{allPaths=**} {
      allow list, get: if true;
      allow create: if request.auth != null && (
      request.auth.token.role in ['admin', 'developer', 'organizer', 'junior']
      );
      allow delete, update: if request.auth != null && (
      request.auth.token.role in ['admin', 'developer'] ||
      (request.auth.token.role in ['organizer', 'junior'] &&
      resource.metadata.uploadedByUID == request.auth.uid)
      );
    }
  }
}
