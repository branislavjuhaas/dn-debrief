/// League type a club participates in.
enum League {
  /// Junior league
  JUNIOR
  /// Senior league
  SENIOR
  /// University league
  UNIVERSITY
}

/// Geographic region of a club.
enum Region {
  /// Western region
  WEST
  /// Central region
  CENTRAL
  /// Eastern region
  EAST
}

/// A debating club. Clubs have managers and memberships (users belonging to the club per year).
model Club {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now())

  /// Human-readable club name
  name          String
  /// Optional club description
  description   String?
  /// Normalized unique search key (e.g., slug or lowercased name)
  search        String        @unique

  /// Whether the club is currently active
  active        Boolean       @default(true)
  /// Competitive league of the club
  league        League        @default(SENIOR)
  /// Optional geographic region
  region        Region?

  /// Membership records linking users to the club for a given year
  memberships   Membership[]
  /// Users that manage this club
  managers      User[]        @relation("ClubManagers")

  @@map("clubs")
  @@index(fields: [search, region, league])
}

/// Membership of a user in a club for a specific year.
model Membership {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now())

  /// The member (user) id
  userId        Int
  /// The member (user)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The club id
  clubId        Int
  /// The club
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Membership year (e.g., 2025)
  year          Int
  /// Whether the membership has been verified/confirmed by the club
  confirmed     Boolean       @default(false)

  @@map("memberships")
  @@unique([userId, clubId, year])
  @@index(fields: [userId, clubId, year])
}