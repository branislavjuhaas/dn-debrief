/// Types of events supported by the platform.
enum EventType {
  /// Debate tournament
  TOURNAMENT
  /// Seminar or workshop
  SEMINAR
  /// Other event type
  OTHER
}

/// An event such as a tournament or seminar.
model Event {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())

  /// If true, event is a draft and not publicly visible
  draft         Boolean     @default(false)

  /// Event name
  name          String
  /// Optional description (markdown or plain text)
  description   String?
  /// Event type
  type          EventType   @default(TOURNAMENT)

  /// Unique event code/slug
  code          String      @unique
  /// Season identifier (e.g., 2025/26)
  season        String
  /// Normalized search key
  search        String

  /// Whether the event is external (not organized by the platform)
  external      Boolean     @default(false)
  /// Location or venue
  location      String?

  /// Start date/time
  beginning     DateTime
  /// End date/time
  end           DateTime

  /// Registration deadline
  deadline      DateTime
  /// Exceptions/overrides (JSON, e.g., per-division deadlines)
  exceptions    Json

  /// Arbitrary event metadata/configuration
  data          Json
  /// Registration configuration/settings
  registration  Json

  /// Organizers of the event
  organizers    User[]      @relation("EventOrganizers")
  /// User registrations for the event
  registrations Registration[]

  @@map("events")
  @@index(fields: [code, search, beginning, end])
}

/// A user's registration for an event.
model Registration {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())

  /// Registered user id (nullable for external users)
  userId        Int?
  /// Registered user (nullable)
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Snapshot of user data for external registrations
  userData      Json?       

  /// Event id
  eventId       Int
  /// Event
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Registration payload (depends on event/role)
  data          Json

  @@map("registrations")
  @@index(fields: [userId, eventId])
}