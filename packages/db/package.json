{
  "name": "@dn-debrief/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "postinstall": "tsdown",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "drizzle-kit": "1.0.0-rc.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
